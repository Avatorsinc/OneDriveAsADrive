<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Windows-only by construction: WinExe, user32/kernel32 P/Invoke, the WAM broker, and the
         Policies registry hive the admin lock reads from. The -windows TFM makes that honest and
         hands us Microsoft.Win32.Registry without an extra package. Publish is unaffected: the
         release workflow uses `-o publish/` and never assumes a TFM folder name. -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- WinExe = no console window by default, so it runs invisibly in the background.
         Pass the console flag to pop a window for debugging (see NativeConsole in Program.cs). -->
    <OutputType>WinExe</OutputType>
    <!-- Stamp a real version so the exe doesn't report 1.0.0.0 (as a crash report once did).
         CI overrides this with -p:Version=x.y.z from the git tag; this is the local fallback. -->
    <Version>1.4.0</Version>
    <Company>Avatorsinc</Company>
    <Product>OneDriveAsADrive</Product>
    <!-- Just for the tray icon and its menu. A background WinExe whose only entry point is a
         command-line switch is invisible to a normal user, so it gets the one piece of UI
         people actually look for. WinForms is the cheapest way to a NotifyIcon; the alternative
         is several hundred lines of Shell_NotifyIcon P/Invoke to end up in the same place. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Opt out of the WinForms entry-point generator: this project has its own top-level
         Program.cs and hosts Kestrel, not a Form. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationIcon>assets\OneDriveAsADrive.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Graph" Version="6.2.0" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.85.2" />
    <PackageReference Include="Microsoft.Identity.Client.Broker" Version="4.85.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embedded as well as set via ApplicationIcon. ApplicationIcon only decorates the exe in
         Explorer; the tray needs to LOAD the icon, and pulling it out of our own assembly means
         there is no loose file to lose during install, xcopy, or single-file publish. -->
    <EmbeddedResource Include="assets\OneDriveAsADrive.ico" LogicalName="OneDriveAsADrive.ico" />
  </ItemGroup>

</Project>
